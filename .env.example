# Copy this file to .env.local and fill in values from your Supabase project
# (Supabase dashboard -> Project Settings -> API). .env.local is never committed.

# Public values: safe for the browser. Row Level Security protects your data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets (added in later phases). Never prefix these with NEXT_PUBLIC_.

# Live market data (server-only). Both have free plans.
# Finnhub: US stocks and index funds in real time + market news. https://finnhub.io/register
FINNHUB_API_KEY=
# Twelve Data: forex and gold in real time. https://twelvedata.com/register
TWELVE_DATA_API_KEY=
# Forex/gold refresh is paced automatically so the free plan's 800 credits/day never run out.
# Uncomment to force a slower minimum (seconds, at least 75):
# TWELVE_DATA_REFRESH_SECONDS=300
# Crypto prices (Coinbase) and the RSS news feeds need no key.
# ANTHROPIC_API_KEY=
